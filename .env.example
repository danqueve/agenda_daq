DB_HOST=localhost
DB_NAME=c2881399_agenda
DB_USER=root
DB_PASS=

APP_URL=http://localhost/agenda
APP_TZ=America/Argentina/Tucuman

# Opcional: integración de SOLO LECTURA con SAS Imperio (buscar y vincular clientes, y ver cuotas
# vencidas, saldo y pagos en cada compromiso). SAS_DB_USER tiene que ser el usuario creado con
# sql/sas_usuario_solo_lectura.sql (agenda_sas_ro), nunca root ni uno con permisos de escritura.
# Si SAS_DB_NAME queda vacío, la integración se apaga sola.
SAS_DB_HOST=localhost
SAS_DB_NAME=
SAS_DB_USER=
SAS_DB_PASS=

VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:danqueve@gmail.com

# Opcional: solo hace falta si el binario "mysqldump" no está en el PATH
# del usuario que corre el cron de cron/backup.php (ver docs/DEPLOY.md).
MYSQLDUMP_BIN=
